{
    "Version":"2012-10-17",
    "Statement":[
        {
            "Effect": "Allow",
            "Action": [
                "s3:GetBucketLocation",
                "s3:GetBucketVersioning",
                "s3:ListBucket",
                "s3:ListBucketVersions",
                "s3:GetObject",
                "s3:GetObjectVersion"
            ],
            "Resource": "*"
       },
        {
            "Effect": "Allow",
            "Action": [
				"es:ESHTTPPut",
				"es:ESHttpGet",
				"es:ESHttpDelete",
				"es:ESHttpPatch",
				"es:ESHttpPost"
			],
            "Resource": "*"
        }
    ]
 }